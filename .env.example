# Names only, never values: this repo is public.
# Copy to .env and fill in. Share real values with each other directly, not through git.

# "mock" runs the app with no accounts or keys. Use "live" only when you need the real thing.
AUTH_MODE=mock
GEMINI_MODE=mock

# Turns on the demo helpers described in docs/PLAN.md
DEMO_MODE=

GEMINI_API_KEY=
DATABASE_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=
