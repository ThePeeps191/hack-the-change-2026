# Names only, never values: this repo is public.
# Copy to .env and fill in. Share real values with each other directly, not through git.

# "mock" runs the app with no accounts or keys. Use "live" only when you need the real thing.
AUTH_MODE=mock
AI_MODE=mock
# Which model does the AI work when AI_MODE=live: claude or gemini. Unset, it's
# Claude if there's an Anthropic key, else Gemini. We swap to gemini for the demo.
AI_PROVIDER=

# Turns on the demo helpers: demo login, bot partner, no daylight or location rules.
DEMO_MODE=

# Keys here beat the same names exported in your shell.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5.
CLAUDE_MODEL=
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Leave empty for embedded Postgres in .data/, which needs no setup. Set it to use Tiger Data.
DATABASE_URL=

# Comma-separated, e.g. ucalgary.ca. Only these emails can meet strangers. Empty allows any verified email.
ALLOWED_EMAIL_DOMAINS=

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=
